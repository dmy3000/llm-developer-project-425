YDB_ENDPOINT_SECRET_ID=
YDB_DATABASE_SECRET_ID=
AGENT_ID=
# URI выбранной модели из конфигурации help-desk; обязателен для учёта истории.
AGENT_MODEL=
YC_FOLDER_ID=

IMAP_HOST=imap.mail.ru
IMAP_USER=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
HELPDESK_MAILBOX=
ALLOWED_SENDER=
TEST_SUBJECT=HEXLET-TEST

# Необязательно: закрытый учебный шлюз. Пустое значение не допускается.
# TICKETS_MCP_URL=https://<домен-шлюза>/sse

# Необязательно локально; вместе включают историю. В облаке берутся из Lockbox.
# YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
# YDB_DATABASE=/ru-central1/<cloud-id>/<database-id>

# Только в Cloud Functions: email-credentials / password → IMAP_PASSWORD.
# Сам пароль в .env и в Git не записывать.
